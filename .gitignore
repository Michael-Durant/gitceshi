# ============================================================================
# 本仓库 .gitignore —— 目的是把「不该上传的东西」挡在提交之外
#
# 说明：
#   * 规则按类别分区，想放开某一类，注释掉对应几行即可。
#   * 已忽略的文件万一确实要提交，用 `git add -f <文件>` 强制加入。
#   * 仓库里绝不能出现明文密码 / 私钥 / API Key，这一类规则放在最前面。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 密钥、凭据、本地环境配置 —— 最高优先级，绝对不要提交
# ---------------------------------------------------------------------------
# 环境变量文件（保留示例文件，方便别人知道要配哪些项）
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 私钥 / 证书 / 密钥库
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.ssh/

# 云厂商 / 服务账号凭据
*service-account*.json
*gcp-key*.json
.aws/
.azure/
.gcloud/
kubeconfig
.kube/

# 各工具保存的令牌 / 密码本
.git-credentials
.netrc
.npmrc
.pypirc
.pgpass
.authinfo
auth.json
token.json
*token*.txt
*credential*.json
*secret*.json
*secret*.yml
*secret*.yaml
secrets.json
secrets.yml
secrets.yaml

# 本地覆盖配置（团队共享的 example 文件除外）
config.local.*
*.local.json
*.local.yml
*.local.yaml
*.local.ini

# ---------------------------------------------------------------------------
# 2. 操作系统 / OneDrive / 资源管理器产生的垃圾文件
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100

# Office 打开文件时的锁文件与临时文件
~$*
~*.tmp
.~lock.*
.padlck
*.laccdb
*.tmp
*.temp
*.crdownload
*.part
*.partial

# OneDrive / 同步冲突副本
*冲突*
*副本.*
*-Copy.*
*-副本

# ---------------------------------------------------------------------------
# 3. 编辑器 / IDE 的个人配置
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
.history/
*.code-workspace

# ---------------------------------------------------------------------------
# 4. 依赖与语言缓存
# ---------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.ipynb_checkpoints/
coverage.xml

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
*.tsbuildinfo
.next/
.nuxt/
.parcel-cache/
.turbo/
.svelte-kit/
coverage/

# 其它语言 / 工具
vendor/
.cache/
.bundle/
elixir_ls/
_build/
deps/
target/
.gradle/

# ---------------------------------------------------------------------------
# 5. 构建产物与编译中间文件（需要发布二进制时请用 git add -f）
# ---------------------------------------------------------------------------
build/
dist/
out/
bin/
obj/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.msi
*.pdb
*.class
*.pyc
*.log
logs/

# ---------------------------------------------------------------------------
# 6. 大文件 / 归档包 / 媒体素材（Git 不适合存，走网盘或 Git LFS）
# ---------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.iso
*.dmg
*.apk
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.psd
*.ai
*.blend

# ---------------------------------------------------------------------------
# 7. 本地数据、数据库、备份
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.bak
*.backup
*.orig
*.rej
/backup/
/data/local/
*.ipynb.autosave
